# Environment Configuration Example for Gardening-ML
# Copy this file to .env and populate with your credentials if needed.

# Google Gemini API Key (Required for LLM daily synthesis in Module 4)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Central DuckDB Server Configuration (Leave default for local/synthetic mode)
DUCKDB_SERVER_HOST=192.168.68.56
DUCKDB_SERVER_PORT=8815
DUCKDB_SERVER_URL=http://192.168.68.56:8815
